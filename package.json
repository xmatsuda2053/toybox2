{
  "name": "toybox2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:stepnote": "npm run dev --workspace=apps/stepnote",
    "build:stepnote": "npm run build --workspace=apps/stepnote",
    "build:all": "npm run build --workspaces",
    "type-check": "npm exec --workspaces -- tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --ui"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.3.1",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@types/papaparse": "^5.5.2",
    "@vitest/ui": "^4.1.11",
    "dexie": "^4.4.5",
    "dexie-export-import": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "github-markdown-css": "^5.9.0",
    "lit": "^3.3.3",
    "marked": "^18.0.11",
    "papaparse": "^5.7.0",
    "sass-embedded": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
