{
  "name": "toybox2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:stepnote": "npm run dev --workspace=apps/stepnote",
    "dev:components": "npm run dev --workspace=packages/components",
    "build:stepnote": "npm run build --workspace=apps/stepnote",
    "build:all": "npm run build --workspaces",
    "type-check": "npm exec --workspaces -- tsc --noEmit",
    "lint": "eslint apps packages",
    "test": "vitest run",
    "test:watch": "vitest --ui"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/papaparse": "^5.5.2",
    "@vitest/ui": "^4.1.11",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.5",
    "dexie-export-import": "^4.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "fake-indexeddb": "^6.2.5",
    "github-markdown-css": "^5.9.0",
    "jscpd": "^5.3.2",
    "lit": "^3.3.3",
    "madge": "^8.0.0",
    "papaparse": "^5.7.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sass-embedded": "^1.104.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
