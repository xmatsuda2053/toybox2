{
  "manifest_version": 3,
  "name": "HubAddress",
  "version": "1.0.0",
  "description": "職員情報・組織情報をサイドパネルで素早く検索・参照できる拡張機能",
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "HubAddress を開く",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-hubaddress-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "HubAddress サイドパネルを開く"
    }
  }
}
