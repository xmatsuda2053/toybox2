{
  "manifest_version": 3,
  "name": "HubAddress Directory Extension",
  "version": "0.1.0",
  "description": "職員一覧・組織一覧クイック参照拡張機能",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}

