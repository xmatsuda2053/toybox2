{
  "manifest_version": 3,
  "name": "HubOffice",
  "version": "0.1.0",
  "description": "事務作業で役立つオフラインツールをサイドパネルで一元管理・切り替え利用できる拡張機能",
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "HubOffice を開く",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-huboffice-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "HubOffice サイドパネルを開く"
    }
  }
}
